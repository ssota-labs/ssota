# --- Local dev only (uncomment for Connect + chat stub; do not use in production) ---
# CONNECT_STUB=1
# STUB_MODEL=1
# SLACK_CONNECT_CONNECTOR=slack/dev
# NOTION_CONNECT_CONNECTOR=notion/dev
# GITHUB_CONNECT_CONNECTOR=github/dev
# DISCORD_CONNECT_CONNECTOR=discord/dev
# LINEAR_CONNECT_CONNECTOR=linear/dev
# --- emulate (optional local provider APIs — see emulate.config.yaml) ---
# EMULATE_ENABLED=1
# EMULATE_OAUTH=1
# EMULATE_SLACK_URL=http://localhost:4003
# EMULATE_GITHUB_URL=http://localhost:4001
# EMULATE_LINEAR_URL=http://localhost:4012
# CONNECTOR_SLACK_DEV_TOKEN=xoxb-local-test
# CREDENTIALS=own-app
# Production SaaS uses Vercel Connect intake (OIDC webhook verify) — no SLACK_SIGNING_SECRET.
# SLACK_SIGNING_SECRET is only for single-workspace dev (SLACK_BOT_TOKEN) or SLACK_CONNECT_INTAKE=0.
