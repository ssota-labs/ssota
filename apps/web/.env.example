# 배포 환경에서만 설정 (Google OAuth). 로컬/E2E에서는 비워 둡니다.
# NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=true
# NEXT_PUBLIC_SITE_URL=https://your-app.example.com

# --- Sentry (에러 추적) ---
# DSN: Sentry 프로젝트 생성 시 발급. 비워 두면 Sentry는 완전히 비활성화됩니다.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# 아래 3개는 빌드 시 소스맵 업로드용 (Vercel/CI env 에만 설정, 로컬은 불필요):
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=sntrys_...
# 연결 확인용 테스트 경로(/api/sentry-test) 가드 토큰. 아무 문자열이나 지정하고
# /api/sentry-test?token=<값> 으로 한 번 접속하면 Sentry에 테스트 이벤트가 갑니다.
# 설정 안 하면 그 경로는 404 (비활성).
# SENTRY_TEST_TOKEN=아무-비밀-문자열
# Server admin connection (bypasses RLS). Never expose to the browser.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- Marketing landing (pre-launch) ---
# MARKETING_ONLY=true  # `/home` 외 경로를 홈으로 리다이렉트 (프로덕션 베타 전용)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=SSOTA <hello@yourdomain.com>

# --- Connectors (adapter: composio | connect | own-app | none) ---
# CONNECTORS picks the backend the agent's connector tools come from.
# Unset (default) = composio when COMPOSIO_API_KEY is set, else the legacy stack.
# CONNECTORS=composio

# Composio Tool Router (default backend)
# Connector tools (Gmail/Drive/Calendar, Slack, Notion, GitHub, Linear, X) are
# served by Composio. Set the API key to enable them; unset → connectors detach.
# COMPOSIO_API_KEY=ck_...
# Per-toolkit auth: set an auth config id to bring your own OAuth app (BYOA) for
# that toolkit; omit to use Composio-managed auth. Env key is the toolkit slug
# uppercased: GMAIL, GOOGLEDRIVE, GOOGLECALENDAR, SLACK, NOTION, GITHUB, LINEAR, TWITTER.
# COMPOSIO_AUTHCONFIG_GMAIL=ac_...
# COMPOSIO_AUTHCONFIG_SLACK=ac_...

# Legacy Vercel Connect backend (CONNECTORS=connect) — preserved for revert / OSS.
# SLACK_MCP_CONNECTOR=slack/acme
# NOTION_MCP_CONNECTOR=notion/ssota
# GITHUB_MCP_CONNECTOR=github/ssota
# DISCORD_MCP_CONNECTOR=discord/ssota
# LINEAR_MCP_CONNECTOR=linear/ssota
# GOOGLE_API_CONNECTOR=google/ssota
# TWITTER_API_CONNECTOR=x.com/ssota
# Own-app tokens (CONNECTORS=own-app): CONNECTOR_<NAME>_TOKEN=...

# --- Inbound chat bot transport (separate from the agent's Composio tools) ---
# The Slack bot's receive/post token defaults to Vercel Connect (resolved per
# installation). Overrides:
# SLACK_CONNECT_CONNECTOR=slack/acme   # Connect connector uid (default "slack")
# SLACK_CONNECT=0                      # disable Connect → static token / signing secret
# SLACK_BOT_TOKEN=xoxb-...             # single static bot token (forces non-Connect)
# SLACK_SIGNING_SECRET=...             # only when SLACK_CONNECT_INTAKE=0 or static token

# --- Local dev only ---
# STUB_MODEL=1
# CONNECT_STUB=1   # stub the legacy Connect OAuth flow (CONNECTORS=connect)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...
