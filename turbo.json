{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "ENABLE_EXPERIMENTAL_COREPACK",
    "JOB_RUNNER",
    "AUTH",
    "BILLING",
    "LOCAL_AUTH_USER_ID",
    "LOCAL_AUTH_USER_EMAIL",
    "MCP_LOCAL_TOKEN",
    "CREDENTIALS",
    "STUDIO_BUILD_STORAGE",
    "S3_BUCKET",
    "S3_REGION",
    "S3_ENDPOINT",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_FORCE_PATH_STYLE",
    "AI_GATEWAY_API_KEY",
    "CRON_SECRET",
    "USE_VERCEL_CONNECT",
    "SLACK_CONNECT_CONNECTOR",
    "DISCORD_CONNECT_CONNECTOR",
    "LINEAR_CONNECT_CONNECTOR",
    "GOOGLE_API_CONNECTOR",
    "DISCORD_BOT_TOKEN",
    "DISCORD_APPLICATION_ID",
    "DISCORD_PUBLIC_KEY",
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_WEBHOOK_SECRET_TOKEN",
    "COMPOSIO_API_KEY",
    "COMPOSIO_AUTHCONFIG_SLACK",
    "COMPOSIO_AUTHCONFIG_NOTION",
    "COMPOSIO_AUTHCONFIG_GOOGLEDRIVE",
    "COMPOSIO_AUTHCONFIG_GOOGLECALENDAR",
    "COMPOSIO_AUTHCONFIG_GITHUB",
    "COMPOSIO_AUTHCONFIG_TWITTER",
    "COMPOSIO_AUTHCONFIG_GMAIL",
    "COMPOSIO_AUTHCONFIG_GOOGLEDOCS",
    "COMPOSIO_AUTHCONFIG_GOOGLESHEETS",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "SENTRY_AUTH_TOKEN",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_SECRET_KEY",
    "STRIPE_PRICE_STARTER",
    "STRIPE_PRICE_BUSINESS",
    "STRIPE_TRIAL_DAYS",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "apps/design-lab/dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@ssota/contracts#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/AGENTS.md",
        "$TURBO_ROOT$/CLAUDE.md",
        "$TURBO_ROOT$/DESIGN.md",
        "$TURBO_ROOT$/scripts/harness/**",
        "$TURBO_ROOT$/packages/config/eslint/**",
        "$TURBO_ROOT$/.github/workflows/**"
      ]
    }
  }
}
