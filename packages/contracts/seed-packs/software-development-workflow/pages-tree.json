  {
    "key": "tpl/initiative/build/tasks",
    "parentKey": "tpl/initiative/build",
    "appliesToNodeType": "initiative",
    "title": "Tasks",
    "icon": "build_tasks",
    "spec": {
      "root": "tabs",
      "elements": {
        "tabs": {
          "type": "Tabs",
          "props": {
            "defaultValue": "table",
            "items": [
              { "value": "table", "label": "Table", "panel": "tablePanel" },
              { "value": "gantt", "label": "Gantt", "panel": "ganttPanel" }
            ]
          }
        },
        "tablePanel": {
          "type": "DataTable",
          "props": {
            "binding": "tasks",
            "title": "Tasks",
            "setAction": "setCell",
            "columns": [
              { "key": "title", "header": "Task", "type": "text", "editable": true, "width": 320 },
              {
                "key": "status",
                "header": "Status",
                "type": "select",
                "options": ["open", "in_progress", "done", "cancelled"]
              },
              { "key": "route", "header": "Route", "type": "text", "editable": true }
            ]
          }
        },
        "ganttPanel": {
          "type": "Gantt",
          "props": {
            "binding": "tasks",
            "title": "Task timeline",
            "startKey": "startAt",
            "endKey": "endAt",
            "statusKey": "status",
            "statusColors": {
              "open": "#6B7280",
              "in_progress": "#F59E0B",
              "done": "#10B981",
              "cancelled": "#EF4444"
            },
            "moveAction": "moveTask"
          }
        }
      }
    },
    "bindings": { "tasks": { "kind": "initiative_scope", "catalogKey": "task" } },
    "actions": {
      "setCell": {
        "kind": "set_node_property",
        "nodeId": { "$input": "nodeId" },
        "field": { "$input": "field" },
        "value": { "$input": "value" }
      },
      "moveTask": {
        "kind": "set_node_property",
        "nodeId": { "$input": "nodeId" },
        "field": "startAt",
        "value": { "$input": "startAt" }
      }
    }
  },
