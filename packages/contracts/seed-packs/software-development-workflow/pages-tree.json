    "spec": { "root": "h", "elements": { "h": { "type": "PageHeader", "props": { "title": "Executive" } } } }
  },
  {
    "key": "executive/roadmap",
    "parentKey": "executive",
    "appliesToNodeType": null,
    "title": "Roadmap",
    "icon": "executive_roadmap",
    "spec": {
      "root": "workspace",
      "elements": {
        "workspace": {
          "type": "RoadmapSheetWorkspace",
          "props": {
            "productBinding": "productRoadmap",
            "planningBinding": "planningRoadmaps",
            "field": "content",
            "subtitleField": "summary",
            "statusField": "lifecycleStatus",
            "sheetSize": "half",
            "editable": true,
            "action": "saveRoadmapDoc",
            "createAnnualAction": "createAnnualRoadmap",
            "createQuarterAction": "createQuarterRoadmap"
          }
        }
      }
    },
    "bindings": {
      "productRoadmap": { "kind": "singleton", "catalogKey": "product_roadmap" },
      "planningRoadmaps": { "kind": "query", "catalogKey": "roadmap" }
    },
    "actions": {
      "saveRoadmapDoc": {
        "kind": "update_node",
        "nodeId": { "$input": "nodeId" },
        "properties": { "content": { "$input": "doc" } },
        "merge": true
      },
      "createAnnualRoadmap": {
        "kind": "create_node",
        "catalogKey": "roadmap",
        "title": { "$input": "title" },
        "properties": {
          "kind": { "$input": "kind" },
          "year": { "$input": "year" },
          "lifecycleStatus": "draft",
          "summary": ""
        }
      },
      "createQuarterRoadmap": {
        "kind": "create_node",
        "catalogKey": "roadmap",
        "title": { "$input": "title" },
        "properties": {
          "kind": { "$input": "kind" },
          "year": { "$input": "year" },
          "quarter": { "$input": "quarter" },
          "lifecycleStatus": "draft",
          "summary": ""
        }
      }
    }
  },
