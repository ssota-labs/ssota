    "parentKey": null,
    "appliesToNodeType": null,
    "title": "Executive",
    "icon": "executive",
    "spec": { "root": "h", "elements": { "h": { "type": "PageHeader", "props": { "title": "Executive" } } } }
  },
  {
    "key": "executive/roadmap",
    "parentKey": "executive",
    "appliesToNodeType": null,
    "title": "Roadmap",
    "icon": "executive_roadmap",
    "spec": {
      "root": "layout",
      "elements": {
        "layout": { "type": "SplitPane", "children": ["product", "planning"] },
        "product": {
          "type": "Section",
          "props": {
            "title": "Product roadmap",
            "subtitle": "Long-term strategic direction"
          },
          "children": ["productDoc"]
        },
        "productDoc": {
          "type": "DocumentEditor",
          "props": {
            "binding": "productRoadmap",
            "field": "content",
            "action": "saveProductDoc"
          }
        },
        "planning": {
          "type": "DocumentSheetList",
          "props": {
            "binding": "planningRoadmaps",
            "sectionTitle": "Planning roadmaps",
            "sectionSubtitle": "Annual and quarterly execution plans",
            "field": "content",
            "subtitleField": "summary",
            "statusField": "lifecycleStatus",
            "sheetSize": "half",
            "editable": true,
            "action": "savePlanningDoc"
          }
        }
      }
    },
    "bindings": {
      "productRoadmap": { "kind": "singleton", "catalogKey": "product_roadmap" },
      "planningRoadmaps": { "kind": "query", "catalogKey": "roadmap" }
    },
    "actions": {
      "saveProductDoc": {
        "kind": "update_node",
        "nodeId": { "$binding": "productRoadmap.id" },
        "properties": { "content": { "$input": "doc" } },
        "merge": true
      },
      "savePlanningDoc": {
        "kind": "update_node",
        "nodeId": { "$input": "nodeId" },
        "properties": { "content": { "$input": "doc" } },
        "merge": true
      }
    }
  },
  {
    "key": "executive/goals",
    "parentKey": "executive",
    "appliesToNodeType": null,
    "title": "Goals",
    "icon": "executive_goals",
    "spec": {
      "root": "okr",
      "elements": {
        "okr": {
          "type": "ExpandableTable",
          "props": {
            "binding": "objectives",
            "title": "Goals",
            "setAction": "setCell",
            "childCellAction": "setCell",
            "childProperty": "keyResults",
            "childLabel": "Key results",
            "columns": [
              { "key": "title", "header": "Objective", "type": "text", "editable": true, "width": 320 },
              { "key": "period", "header": "Period", "type": "text", "editable": true, "width": 120 },
              {
                "key": "status",
                "header": "Status",
                "type": "select",
                "options": ["on-track", "at-risk", "off-track"]
              }
            ],
            "childColumns": [
              { "key": "title", "header": "Key result", "type": "text", "editable": true, "width": 320 },
              { "key": "current_value", "header": "Current", "type": "number", "editable": true },
              { "key": "target", "header": "Target", "type": "number", "editable": true },
              { "key": "unit", "header": "Unit", "type": "text" },
              {
                "key": "status",
                "header": "Status",
                "type": "select",
                "options": ["on-track", "at-risk", "off-track"]
              }
            ]
          }
        }
      }
    },
    "bindings": {
      "objectives": {
        "kind": "query",
        "catalogKey": "objective",
        "attachChildren": {
          "edgeCatalogKey": "contributes_to",
          "direction": "in",
          "catalogKey": "key_result",
          "property": "keyResults"
        }
      }
    },
    "actions": {
      "setCell": {
        "kind": "set_node_property",
        "nodeId": { "$input": "nodeId" },
        "field": { "$input": "field" },
        "value": { "$input": "value" }
      }
    }
  },
