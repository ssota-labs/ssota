{
  "name": "@ssota/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "default": "./dist/catalog/index.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "default": "./dist/graph/index.js"
    },
    "./workflows": {
      "types": "./dist/workflows/index.d.ts",
      "default": "./dist/workflows/index.js"
    },
    "./page": {
      "types": "./dist/page/index.d.ts",
      "default": "./dist/page/index.js"
    },
    "./seed-packs/software-development-workflow/*": "./seed-packs/software-development-workflow/*"
  },
  "scripts": {
    "build": "tsx scripts/embed-workflow-instructions.ts && tsc",
    "dev": "tsc --watch",
    "lint": "eslint src",
    "typecheck": "tsx scripts/embed-workflow-instructions.ts && tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@ssota/config": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "eslint": "^9.28.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
