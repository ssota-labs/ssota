{
  "extends": "@ssota/config/typescript/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@ssota/ui/*": ["../ui/src/*"],
      "@/lib/utils": ["../ui/src/lib/utils.ts"],
      "@/components/ui/*": ["../ui/src/components/ui/*"],
      "@/hooks/*": ["../ui/src/hooks/*"]
    }
  },
  "include": ["src", "../ui/src"],
  "//": "ui/src is included so @ssota/ui sources resolve; exclude its Storybook stories — they use @/components/* path aliases that only resolve under ui's own tsconfig, not editor's.",
  "exclude": ["node_modules", "dist", "../ui/src/**/*.stories.tsx"]
}
