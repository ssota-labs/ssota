{
  "name": "ssota",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter e2e test",
    "e2e:prepare": "pnpm exec supabase start && pnpm db:migrate && pnpm db:seed",
    "cloud:prepare": "bash scripts/cloud-bootstrap.sh",
    "sync:env": "bash scripts/sync-supabase-env.sh",
    "e2e:report": "pnpm --filter e2e test:report",
    "db:generate": "pnpm --filter @ssota/adapter-supabase db:generate",
    "db:migrate": "pnpm exec supabase migration up --local",
    "db:migrate:down": "pnpm exec supabase migration down --local",
    "db:migration:new": "pnpm exec supabase migration new",
    "db:migration:list": "pnpm exec supabase migration list --local",
    "db:reset": "pnpm exec supabase db reset --local",
    "db:seed": "pnpm --filter @ssota/adapter-supabase db:seed",
    "migrate:notion": "tsx scripts/m6-notion-migration.ts",
    "embedder-bff": "tsx examples/embedder-bff/server.ts",
    "storybook": "pnpm --filter storybook dev",
    "design-lab": "pnpm --filter design-lab dev"
  },
  "devDependencies": {
    "@ssota/client": "workspace:*",
    "supabase": "^2.105.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "tsx": "^4.19.4"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": "24.x"
  }
}
