{
  "name": "ssota",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "bash scripts/e2e-report.sh",
    "e2e:ci": "bash scripts/e2e-report.sh --no-report",
    "e2e:prepare": "pnpm exec supabase start && pnpm db:migrate && pnpm db:seed",
    "cloud:prepare": "bash scripts/cloud-bootstrap.sh",
    "sync:env": "bash scripts/sync-supabase-env.sh",
    "e2e:report": "pnpm e2e",
    "db:generate": "pnpm --filter @ssota/adapter-postgres db:generate",
    "db:migrate": "pnpm exec supabase migration up --local",
    "db:migrate:down": "pnpm exec supabase migration down --local",
    "db:migration:new": "pnpm exec supabase migration new",
    "db:migration:list": "pnpm exec supabase migration list --local",
    "db:reset": "pnpm exec supabase db reset --local",
    "db:seed": "pnpm --filter @ssota/adapter-postgres db:seed",
    "db:seed:demo-connections": "pnpm exec tsx scripts/seed-demo-connections.ts",
    "design-lab": "pnpm --filter design-lab dev",
    "design-lab:build": "pnpm --filter design-lab build",
    "e2e:design-lab": "pnpm --filter e2e exec playwright test -c playwright.design-lab.config.ts",
    "emulate:dev": "bash scripts/emulate-dev.sh",
    "emulate:ports": "bash scripts/emulate-dev-ports.sh",
    "e2e:emulate": "pnpm --filter e2e exec playwright test -c playwright.emulate.config.ts"
  },
  "devDependencies": {
    "@ssota/client": "workspace:*",
    "emulate": "^0.8.0",
    "supabase": "^2.105.0",
    "tsx": "^4.19.4",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": "24.x"
  }
}
