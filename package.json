{
  "name": "loopos",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter e2e test",
    "e2e:prepare": "pnpm exec supabase start && pnpm db:migrate && pnpm db:seed",
    "e2e:report": "pnpm --filter e2e test:report",
    "db:generate": "pnpm --filter @loopos/adapter-supabase db:generate",
    "db:migrate": "pnpm --filter @loopos/adapter-supabase db:migrate",
    "db:seed": "pnpm --filter @loopos/adapter-supabase db:seed",
    "migrate:notion": "tsx scripts/m6-notion-migration.ts",
    "storybook": "pnpm --filter storybook dev"
  },
  "devDependencies": {
    "supabase": "^2.105.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "tsx": "^4.19.4"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24"
  }
}
