# SSOTA self-host (OSS) — fully local, no Vercel or Supabase account required.
# Copy to apps/web/.env (and apps/mcp/.env) and adjust as needed.

# --- Open-core adapter selection -------------------------------------------
JOB_RUNNER=inline            # in-process agent runs (no durability). Enterprise: workflow
AUTH=local                   # single always-signed-in user. Enterprise: supabase
CREDENTIALS=own-app          # connector tokens from env. Enterprise: connect
STUDIO_BUILD_STORAGE=local   # filesystem build artifacts. Or: s3

# --- Local single-user identity (matches the docker-compose seed) ----------
LOCAL_AUTH_USER_ID=00000000-0000-0000-0000-000000000001
LOCAL_AUTH_USER_EMAIL=dev@localhost

# --- Database (docker-compose Postgres) ------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Local storage root (for STUDIO_BUILD_STORAGE=local) -------------------
STUDIO_BUILD_LOCAL_ROOT=/tmp/ssota-studio-builds

# --- Connectors (own-app): register your own OAuth app, paste its token ----
# CONNECTOR_SLACK_TOKEN=xoxb-...
# CONNECTOR_NOTION_TOKEN=secret_...
# Per-install override: CONNECTOR_SLACK_<INSTALLATION>_TOKEN=...

# --- Optional: S3 / MinIO instead of local storage -------------------------
# STUDIO_BUILD_STORAGE=s3
# S3_BUCKET=ssota
# S3_ENDPOINT=http://127.0.0.1:9000   # MinIO / R2 endpoint (omit for AWS)
# S3_FORCE_PATH_STYLE=1               # required for MinIO
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
